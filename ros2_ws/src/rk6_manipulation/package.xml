<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rk6_manipulation</name>
  <version>0.1.0</version>
  <description>rk6 ek senaryo: ters kinematik, kamera ile kup algilama, al-birak ve ust uste dizme</description>
  <maintainer email="mahmutkucukakyuz@ogr.iuc.edu.tr">Mahmut</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rk6_description</exec_depend>
  <exec_depend>rk6_control</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
